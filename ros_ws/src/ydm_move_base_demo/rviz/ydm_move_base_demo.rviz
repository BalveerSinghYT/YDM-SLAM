Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
      Splitter Ratio: 0.5
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 160
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 20
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0

    - Class: rviz/PointCloud2
      Enabled: true
      Name: YDM Static Cloud
      Topic: /ydm/static_cloud
      Queue Size: 1
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Color Transformer: RGB8
      Use Fixed Frame: true

    - Class: rviz/PointCloud2
      Enabled: true
      Name: YDM Dynamic Cloud
      Topic: /ydm/dynamic_cloud
      Queue Size: 1
      Style: Points
      Size (Pixels): 3
      Alpha: 1
      Color Transformer: RGB8
      Use Fixed Frame: true

    - Class: rviz/Map
      Enabled: true
      Name: Local Costmap
      Topic: /move_base/local_costmap/costmap
      Alpha: 0.7
      Color Scheme: costmap

    - Class: rviz/Map
      Enabled: true
      Name: Global Costmap
      Topic: /move_base/global_costmap/costmap
      Alpha: 0.35
      Color Scheme: costmap

    - Class: rviz/Path
      Enabled: true
      Name: Global Plan
      Topic: /move_base/NavfnROS/plan
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.03

    - Class: rviz/Path
      Enabled: true
      Name: Local Plan
      Topic: /move_base/TrajectoryPlannerROS/local_plan
      Color: 255; 165; 0
      Line Style: Lines
      Line Width: 0.03

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 25
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Orbit
      Pitch: 0.7
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
  X: 50
  Y: 50
