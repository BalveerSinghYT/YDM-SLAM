<?xml version="1.0"?>
<package format="2">
  <name>ydm_octomap_bridge</name>
  <version>0.0.1</version>
  <description>Publish per-keyframe PCDs (static/dynamic) as ROS1 PointCloud2 for octomap_server + RViz.</description>

  <maintainer email="noreply@example.com">ydm</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>pcl_ros</build_depend>
  <build_depend>pcl_conversions</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>pcl_conversions</exec_depend>
  <exec_depend>octomap_server</exec_depend>
</package>
